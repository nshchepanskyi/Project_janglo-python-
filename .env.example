SECRET_KEY=

# --- База даних ---
# Локально: SQLite (DB_NAME = шлях до db.sqlite3)
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=C:\path\to\db.sqlite3
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# --- PostgreSQL (варіант локальної/іншої бази) ---
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=janglo_hotel
# DB_USER=janglo
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432

# --- TiDB Cloud на Render (MySQL-сумісний, TLS) ---
# DB_ENGINE=django.db.backends.mysql
# DB_HOST=gateway01.<region>.aws.tidbcloud.com
# DB_PORT=4000
# DB_SSL_CA=/etc/ssl/certs/ca-certificates.crt   # опційно: повна перевірка TLS
# DB_SSL_VERIFY=true

# --- Прод / Render ---
# DEBUG=False
# ALLOWED_HOSTS=your-app.onrender.com
# CSRF_TRUSTED_ORIGINS=https://your-app.onrender.com
# TRUST_X_FORWARDED_PROTO=true

# By default, development emails are printed to the console.
# Gmail SMTP requires 2-Step Verification and a Google App Password.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=noreply@example.com
# EMAIL_HOST_PASSWORD=your-google-app-password
# EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=noreply.grandstayhotel@gmail.com

# --- Розсилка листів через Resend API (HTTPS, порт 443) ---
# Render Free блокує SMTP-порти 25/465/587, тому у продакшені листи
# (код підтвердження реєстрації) надсилаються через Resend API.
# Ключ береться з Resend Dashboard -> API Keys (Sending access).
# DEFAULT_FROM_EMAIL має належати домену, підтвердженому в Resend.
# RESEND_API_KEY=

# ID опублікованого HTML-шаблону листа підтвердження у Resend
# (Resend Dashboard -> Templates -> потрібний шаблон -> ID шаблону).
# Шаблон має змінні {{ USERNAME }} та {{ CODE }}.
# Якщо не задано — лист формується inline-HTML (fallback).
# RESEND_VERIFICATION_TEMPLATE_ID=

# Для проду відправник має бути з підтвердженого домену:
# DEFAULT_FROM_EMAIL=GrandStay <noreply@grandstay.top>
